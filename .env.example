# Server Environment
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://sample-redis-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# Email (Resend)
RESEND_API_KEY=re_sample_resend_api_key

# Admin Authentication
ADMIN_SESSION_SECRET=min_32_characters_random_string_for_cookie_signing
